PORT=3000

JWT_SECRET=elektrolearn-dev-secret
JWT_EXPIRES_IN=12h

# Print startup banner (WARNING: can expose secrets)
# true = masked secrets, full = show everything
SHOW_BOOT_INFO=true

# If you have a public domain, set it (example: https://api.example.com)
PUBLIC_DOMAIN=

# Local Postgres
DATABASE_URL=postgresql://sarvarbekxazratov@localhost:5432/elektrolearn
DB_SYNCHRONIZE=false

# Refresh token settings
REFRESH_TOKEN_DAYS=30

# Default seeded superadmin (MVP)
SUPERADMIN_EMAIL=elektroLearn@admin.com
SUPERADMIN_PASSWORD=!Qw3rty

# Energo ID integration (required in production)
# Private network IP of Energo ID server — NOT localhost on prod ElektroLearn server
# Example: http://10.0.0.5:8080
ENERGO_ID_BASE_URL=
ENERGO_ID_PLATFORM=elektrolearn
ENERGO_ID_CLIENT_ID=elektrolearn_backend
ENERGO_ID_CLIENT_SECRET=
ENERGO_ID_TIMEOUT_MS=15000

# Keep false in production — employees authenticate via Energo ID only
AUTH_LOCAL_FALLBACK_ENABLED=false
